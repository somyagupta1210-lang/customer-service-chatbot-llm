# Required only when you want Gemini to rewrite the final FAQ answer.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Retrieval / quality controls
RETRIEVAL_THRESHOLD=0.28
QUALITY_ACCURACY_TOLERANCE=0.02
QUALITY_GROUNDING_TOLERANCE=0.02

# Knowledge-base update operations
SCHEDULED_UPDATE_TIME=02:00
MAINTENANCE_WINDOW_START=02:00
MAINTENANCE_WINDOW_END=04:00
RETRY_DELAYS_MINUTES=15,30,60
HEALTH_CHECK_MINUTES=5
MAX_DOCUMENT_SIZE_MB=10
MAX_HEALTH_LATENCY_MS=5000

# Admin credentials for the local demo. CHANGE THESE in your real .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Tasks 2-6
UPLOAD_RETENTION_MINUTES=60
MEDIA_BACKGROUND_AFTER_SECONDS=30
MAX_UPLOAD_MB=10
SUPPORTED_UPLOAD_EXTENSIONS=.png,.jpg,.jpeg,.webp,.pdf,.txt
SUPPORTED_LANGUAGES=en,hi,es,fr
LANGUAGE_CONFIDENCE_THRESHOLD=0.55
INTENT_CONFIDENCE_THRESHOLD=0.45
SESSION_INACTIVITY_MINUTES=30
SESSION_RESTORE_HOURS=24
CONTEXT_MESSAGES=10
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18
WEEKEND_DAYS=5,6
HOLIDAYS=
NEGATIVE_ESCALATION_MINUTES=15
SLA_WARNING_FRACTION=0.75
